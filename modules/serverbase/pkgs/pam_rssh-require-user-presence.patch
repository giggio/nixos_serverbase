+#[cfg(test)]
+fn sk_ed25519_signature(flags: u8, challenge: &[u8]) -> (PublicKey, Vec<u8>) {
+    use byteorder::{BigEndian, WriteBytesExt};
+    use openssl::sha::sha256;
+    use openssl::sign::Signer;
+    use ssh_agent::proto::public_key::SkEd25519PublicKey;
+
+    let application = String::from("ssh:");
+    let key = PKey::generate_ed25519().unwrap();
+    let counter = 7u32;
+    // what a FIDO authenticator signs: sha256(application) || flags || counter || sha256(data)
+    let mut signed = Vec::new();
+    signed.extend_from_slice(&sha256(application.as_bytes()));
+    signed.push(flags);
+    signed.write_u32::<BigEndian>(counter).unwrap();
+    signed.extend_from_slice(&sha256(challenge));
+    let blob = Signer::new_without_digest(&key)
+        .unwrap()
+        .sign_oneshot_to_vec(&signed)
+        .unwrap();
+    let pubkey = PublicKey::SkEd25519(SkEd25519PublicKey {
+        enc_a: key.raw_public_key().unwrap(),
+        application,
+    });
+    let sig = proto::SkSignature {
+        algorithm: String::from("sk-ssh-ed25519@openssh.com"),
+        blob,
+        flags,
+        counter,
+    };
+    (pubkey, proto::to_bytes(&sig).unwrap())
+}
+
+#[test]
+fn test_sk_signature_with_user_presence_is_accepted() {
+    let challenge = gen_challenge().unwrap();
+    let (pubkey, sig) = sk_ed25519_signature(SK_USER_PRESENT, &challenge);
+    assert!(verify_signature(&challenge, &pubkey, &sig).unwrap());
+    // and it is really verified, not waved through
+    let other = gen_challenge().unwrap();
+    assert!(!verify_signature(&other, &pubkey, &sig).unwrap());
+}
+
+#[test]
+fn test_sk_signature_without_user_presence_is_rejected() {
+    let challenge = gen_challenge().unwrap();
+    // a valid signature, only the touch is missing
+    let (pubkey, sig) = sk_ed25519_signature(0, &challenge);
+    assert!(verify_signature(&challenge, &pubkey, &sig).is_err());
+}
