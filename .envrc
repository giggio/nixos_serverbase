# shellcheck shell=bash
# Without the devenv CLI (the flakes integration) the task runner prints a line per task on every shell entry.
export DIRENV_LOG_FORMAT=
export DEVENV_TASKS_QUIET=1
# Must match `devenv.root` in flake.nix; devenv keeps its state and installs the git hook there.
devenv_root=/home/giggio/p/nix/servers/nixos_serverbase
if [ "$(pwd -P)" != "$devenv_root" ]; then
  printf '\033[31mThis clone is not at %s, where flake.nix sets devenv.root: the devenv shell and its git hooks will fail. Change devenv.root there and devenv_root here.\033[0m\n' "$devenv_root" >&2
fi
if systemd-detect-virt &>/dev/null; then
  use flake .#vm
else
  use flake
fi
